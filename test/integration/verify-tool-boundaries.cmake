# Run in an x64 MSVC developer environment with VSLANG=1033.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED REPO OR NOT DEFINED OUTPUT OR NOT DEFINED NINJA)
    message(FATAL_ERROR "Pass REPO, OUTPUT and NINJA absolute paths.")
endif()
foreach(mode IN ITEMS runner-only game-only standalone-runner)
    set(source "${REPO}")
    set(options -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release "-DCMAKE_MAKE_PROGRAM=${NINJA}")
    if(mode STREQUAL "runner-only")
        list(APPEND options -DSYMOCRAFT_BUILD_GAME=OFF -DSYMOCRAFT_BUILD_BENCHMARK=ON)
    elseif(mode STREQUAL "game-only")
        list(APPEND options -DSYMOCRAFT_BUILD_GAME=ON -DSYMOCRAFT_BUILD_BENCHMARK=OFF)
    else()
        set(source "${REPO}/tools/benchmark")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${OUTPUT}/${mode}" -G Ninja ${options}
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${OUTPUT}/${mode}" --parallel 8 COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${OUTPUT}/${mode}/build.ninja" graph)
    if(mode STREQUAL "game-only")
        if(graph MATCHES "benchmark_core.dir" OR EXISTS "${OUTPUT}/${mode}/bin/SymoCraftBenchmark.exe")
            message(FATAL_ERROR "Game-only build leaked the runner.")
        endif()
    else()
        if(graph MATCHES "symocraft_glad.dir|SymoCraft.dir|vendor/glfw" OR EXISTS "${OUTPUT}/${mode}/bin/SymoCraft.exe")
            message(FATAL_ERROR "Runner-only build leaked game/GL dependencies.")
        endif()
    endif()
    message(STATUS "${mode}: build and dependency boundary passed")
endforeach()
