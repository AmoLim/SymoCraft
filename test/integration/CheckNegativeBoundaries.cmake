cmake_minimum_required(VERSION 3.22)
file(MAKE_DIRECTORY "${OUTPUT}")

function(check_boundary case root accepted expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/result.log" "${output}${error}")
    if(accepted)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Positive boundary case ${case} was rejected: ${output}${error}")
        endif()
        set_property(GLOBAL APPEND PROPERTY SYMOCRAFT_ACCEPTED_BOUNDARIES "${case}")
    elseif(result EQUAL 0 OR NOT error MATCHES "Boundary violation" OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "Negative boundary case ${case} failed for the wrong reason: ${output}${error}")
    else()
        set_property(GLOBAL APPEND PROPERTY SYMOCRAFT_REJECTED_BOUNDARIES "${case}")
    endif()
endfunction()

function(check_source case root module path content accepted)
    file(WRITE "${path}" "${content}")
    file(WRITE "${root}/probe.cmake"
        "cmake_minimum_required(VERSION 3.22)\ninclude(\"${REPO}/cmake/ModuleBoundaries.cmake\")\nsymocraft_check_source_file(\"${root}\" \"${module}\" \"${path}\")\n")
    check_boundary("${case}" "${root}" "${accepted}" "Boundary violation" -P "${root}/probe.cmake")
endfunction()

function(check_target case root cmakelists accepted expected)
    string(APPEND cmakelists "include(\"${REPO}/cmake/ModuleBoundaries.cmake\")\nsymocraft_validate_boundaries()\n")
    file(WRITE "${root}/CMakeLists.txt" "${cmakelists}")
    check_boundary("${case}" "${root}" "${accepted}" "${expected}"
        -S "${root}" -B "${root}/build" -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}")
endfunction()

set(cases world-renderer simulation-platform module-app production-test private-cross-include public-sdk
    sdl-platform-source sdl-platform-public sdl-platform-bridge sdl-platform-bridge-source sdl-renderer-source sdl-app-source
    sdl-cpu-source sdl-relative-vendor sdl-relative-platform-vendor
    glfw-platform-source glfw-renderer-source glfw-app-source glfw-cpu-source glfw-platform-public glfw-relative-vendor)
foreach(case IN LISTS cases)
    set(root "${OUTPUT}/${case}")
    file(MAKE_DIRECTORY "${root}/game/modules/world/src" "${root}/game/modules/simulation/src"
        "${root}/game/modules/renderer/src" "${root}/game/modules/world/include/symocraft/world"
        "${root}/game/modules/platform/src/graphics_bridge" "${root}/game/modules/platform/include/symocraft/platform"
        "${root}/game/app/src" "${root}/vendor/sdl3/include/SDL3" "${root}/vendor/glfw/include/GLFW")
    set(module world)
    set(path "${root}/game/modules/world/src/rejected.cpp")
    set(accepted FALSE)
    if(case STREQUAL "world-renderer")
        set(content "#include <symocraft/renderer/renderer.h>\n")
    elseif(case STREQUAL "simulation-platform")
        set(module simulation)
        set(path "${root}/game/modules/simulation/src/rejected.cpp")
        set(content "#include <symocraft/platform/window.h>\n")
    elseif(case STREQUAL "module-app")
        set(content "#include <app/application.h>\n")
    elseif(case STREQUAL "production-test")
        set(content "#include <test/support/fixture.h>\n")
    elseif(case STREQUAL "private-cross-include")
        file(WRITE "${root}/game/modules/renderer/src/batch.hpp" "#pragma once\n")
        set(content "#include \"../../renderer/src/batch.hpp\"\n")
    elseif(case MATCHES "^glfw-")
        set(content "#include <GLFW/glfw3.h>\n")
        if(case MATCHES "^glfw-platform" OR case STREQUAL "glfw-relative-vendor")
            set(module platform)
            set(path "${root}/game/modules/platform/src/rejected.cpp")
        elseif(case STREQUAL "glfw-renderer-source")
            set(module renderer)
            set(path "${root}/game/modules/renderer/src/rejected.cpp")
        elseif(case STREQUAL "glfw-app-source")
            set(module app)
            set(path "${root}/game/app/src/rejected.cpp")
        endif()
        if(case STREQUAL "glfw-platform-public")
            set(path "${root}/game/modules/platform/include/symocraft/platform/rejected.h")
        elseif(case STREQUAL "glfw-relative-vendor")
            file(WRITE "${root}/vendor/glfw/include/GLFW/glfw3.h" "#pragma once\n")
            get_filename_component(directory "${path}" DIRECTORY)
            file(RELATIVE_PATH vendor_header "${directory}" "${root}/vendor/glfw/include/GLFW/glfw3.h")
            set(content "#include \"${vendor_header}\"\n")
        endif()
    elseif(case MATCHES "^sdl-")
        set(content "#include <SDL3/SDL.h>\n")
        if(case MATCHES "^sdl-platform" OR case STREQUAL "sdl-relative-platform-vendor")
            set(module platform)
            set(path "${root}/game/modules/platform/src/rejected.cpp")
        elseif(case STREQUAL "sdl-renderer-source")
            set(module renderer)
            set(path "${root}/game/modules/renderer/src/rejected.cpp")
        elseif(case STREQUAL "sdl-app-source")
            set(module app)
            set(path "${root}/game/app/src/rejected.cpp")
        endif()
        if(case STREQUAL "sdl-platform-source")
            set(accepted TRUE)
        elseif(case STREQUAL "sdl-platform-public")
            set(path "${root}/game/modules/platform/include/symocraft/platform/rejected.h")
        elseif(case STREQUAL "sdl-platform-bridge")
            set(path "${root}/game/modules/platform/src/graphics_bridge/rejected.h")
        elseif(case STREQUAL "sdl-platform-bridge-source")
            set(path "${root}/game/modules/platform/src/graphics_bridge/accepted.cpp")
            set(accepted TRUE)
        elseif(case MATCHES "^sdl-relative-")
            file(WRITE "${root}/vendor/sdl3/include/SDL3/SDL.h" "#pragma once\n")
            get_filename_component(directory "${path}" DIRECTORY)
            file(RELATIVE_PATH vendor_header "${directory}" "${root}/vendor/sdl3/include/SDL3/SDL.h")
            set(content "#include \"${vendor_header}\"\n")
        endif()
    else()
        set(path "${root}/game/modules/world/include/symocraft/world/rejected.h")
        set(content "#include <yaml-cpp/yaml.h>\n")
    endif()
    check_source("${case}" "${root}" "${module}" "${path}" "${content}" "${accepted}")
endforeach()

# Physics is a nested owner, not part of simulation's private implementation.
function(physics_source_case case module path header accepted)
    set(root "${OUTPUT}/${case}")
    set(physics "${root}/game/modules/simulation/physics")
    file(MAKE_DIRECTORY "${physics}/src" "${physics}/include/symocraft/physics"
        "${root}/game/modules/simulation/src")
    file(WRITE "${physics}/src/physics_private.h" "#pragma once\n")
    file(WRITE "${root}/game/modules/simulation/src/session_private.h" "#pragma once\n")
    check_source("${case}" "${root}" "${module}" "${root}/game/modules/simulation/${path}"
        "#include ${header}\n" "${accepted}")
endfunction()

physics_source_case(physics-source-foundation physics physics/src/probe.cpp "<symocraft/foundation/math.h>" TRUE)
physics_source_case(physics-source-own-private physics physics/src/probe.cpp "\"physics_private.h\"" TRUE)
physics_source_case(physics-source-simulation physics physics/src/probe.cpp "<symocraft/simulation/player_math.h>" FALSE)
physics_source_case(physics-source-world physics physics/src/probe.cpp "<symocraft/world/world.h>" FALSE)
physics_source_case(physics-source-windows physics physics/src/probe.cpp "<Windows.h>" FALSE)
physics_source_case(physics-source-vulkan physics physics/src/probe.cpp "<vulkan/vulkan_core.h>" FALSE)
physics_source_case(physics-public-sdk physics physics/include/symocraft/physics/probe.h "<d3d12.h>" FALSE)
physics_source_case(physics-public-own-private physics physics/include/symocraft/physics/probe.h "\"../../../src/physics_private.h\"" FALSE)
physics_source_case(physics-public-short-private physics physics/include/symocraft/physics/probe.h "<physics_private.h>" FALSE)
physics_source_case(physics-source-relative-simulation physics physics/src/probe.cpp "\"../../src/session_private.h\"" FALSE)
physics_source_case(physics-source-short-simulation physics physics/src/probe.cpp "<session_private.h>" FALSE)
physics_source_case(simulation-source-physics-public simulation src/probe.cpp "<symocraft/physics/physics.h>" TRUE)
physics_source_case(simulation-source-relative-physics simulation src/probe.cpp "\"../physics/src/physics_private.h\"" FALSE)
physics_source_case(simulation-source-short-physics simulation src/probe.cpp "<physics_private.h>" FALSE)

# Configure real targets to verify the core's owner, include roots and full link closure.
foreach(case IN ITEMS physics-target-private-consumer physics-target-narrow-roots
    physics-target-simulation-public physics-target-world-consumer physics-target-app-consumer
    physics-target-app-alias-consumer physics-target-app-expression-consumer physics-target-app-expression-alias-consumer
    physics-path-simulation-include physics-path-simulation-src physics-path-public-src
    physics-path-external-sdk physics-path-simulation-physics-include
    physics-link-direct-world physics-link-indirect-world physics-link-expression-world
    physics-link-native-library physics-source-wrong-owner physics-target-wrong-owner)
    set(root "${OUTPUT}/${case}")
    set(physics "${root}/game/modules/simulation/physics")
    file(MAKE_DIRECTORY "${physics}/src" "${physics}/include/symocraft/physics"
        "${root}/game/modules/foundation/src" "${root}/game/modules/simulation/src"
        "${root}/game/modules/world/src" "${root}/game/app/src" "${root}/test/src")
    set(cmakelists "cmake_minimum_required(VERSION 3.22)\nproject(PhysicsBoundary LANGUAGES NONE)\nset(CMAKE_CXX_ARCHIVE_CREATE \"<CMAKE_COMMAND> -E true\")\nset(CMAKE_CXX_ARCHIVE_FINISH \"<CMAKE_COMMAND> -E true\")\nset(SYMOCRAFT_REPOSITORY_ROOT \"${root}\")\nadd_library(symocraft_math INTERFACE)\n")
    file(WRITE "${root}/game/modules/foundation/src/owned.cpp" "int foundation_owned() { return 0; }\n")
    file(WRITE "${root}/game/modules/foundation/CMakeLists.txt"
        "add_library(symocraft_foundation STATIC src/owned.cpp)\nset_target_properties(symocraft_foundation PROPERTIES LINKER_LANGUAGE CXX)\ntarget_link_libraries(symocraft_foundation PUBLIC symocraft_math)\n")
    string(APPEND cmakelists "add_subdirectory(game/modules/foundation)\n")
    set(core_cmake "add_library(symocraft_physics STATIC src/owned.cpp)\nset_target_properties(symocraft_physics PROPERTIES LINKER_LANGUAGE CXX)\ntarget_include_directories(symocraft_physics PUBLIC \"${physics}/include\" PRIVATE \"${physics}/src\")\ntarget_link_libraries(symocraft_physics PUBLIC symocraft_foundation)\n")
    file(WRITE "${physics}/src/owned.cpp" "int physics_owned() { return 0; }\n")
    set(expected "Boundary violation")
    set(accepted FALSE)
    if(case STREQUAL "physics-target-private-consumer")
        set(accepted TRUE)
        set(consumer simulation)
        set(consumer_target symocraft_simulation)
        set(consumer_scope PRIVATE)
    elseif(case STREQUAL "physics-target-narrow-roots")
        set(accepted TRUE)
    elseif(case STREQUAL "physics-target-simulation-public")
        set(consumer simulation)
        set(consumer_target symocraft_simulation)
        set(consumer_scope PUBLIC)
        set(expected "simulation publishes internal physics")
    elseif(case STREQUAL "physics-target-world-consumer")
        set(consumer world)
        set(consumer_target symocraft_world)
        set(consumer_scope PRIVATE)
        set(expected "internal physics cannot be consumed")
    elseif(case MATCHES "^physics-target-app(-alias|-expression|-expression-alias)?-consumer$")
        set(consumer app)
        set(consumer_target symocraft_startup)
        set(consumer_scope PRIVATE)
        if(case STREQUAL "physics-target-app-alias-consumer" OR case STREQUAL "physics-target-app-expression-alias-consumer")
            set(expected "internal physics target aliases are not approved")
        elseif(case STREQUAL "physics-target-app-expression-consumer")
            set(expected "internal physics requires a direct approved target")
        else()
            set(expected "internal physics cannot be consumed")
        endif()
    elseif(case STREQUAL "physics-path-simulation-include")
        string(APPEND core_cmake "target_include_directories(symocraft_physics PRIVATE \"${root}/game/modules/simulation/include\")\n")
        set(expected "physics gains an unauthorized include root")
    elseif(case STREQUAL "physics-path-simulation-src")
        string(APPEND core_cmake "target_include_directories(symocraft_physics PRIVATE \"${root}/game/modules/simulation/src\")\n")
        set(expected "physics gains an unauthorized include root")
    elseif(case STREQUAL "physics-path-public-src")
        string(APPEND core_cmake "target_include_directories(symocraft_physics PUBLIC \"${physics}/src\")\n")
        set(expected "physics may only publish its narrow include root")
    elseif(case STREQUAL "physics-path-external-sdk")
        string(APPEND core_cmake "target_include_directories(symocraft_physics PRIVATE \"${root}/vendor/graphics-sdk/include\")\n")
        set(expected "physics gains an unauthorized include root")
    elseif(case STREQUAL "physics-path-simulation-physics-include")
        set(consumer simulation)
        set(consumer_target symocraft_simulation)
        set(expected "gains an internal physics include")
    elseif(case MATCHES "^physics-link-(direct|indirect|expression)-world$")
        file(WRITE "${root}/game/modules/world/src/owned.cpp" "int world_owned() { return 0; }\n")
        file(WRITE "${root}/game/modules/world/CMakeLists.txt"
            "add_library(symocraft_world STATIC src/owned.cpp)\nset_target_properties(symocraft_world PROPERTIES LINKER_LANGUAGE CXX)\n")
        string(APPEND cmakelists "add_subdirectory(game/modules/world)\n")
        if(case STREQUAL "physics-link-direct-world")
            string(APPEND core_cmake "target_link_libraries(symocraft_physics PRIVATE symocraft_world)\n")
            set(expected "target symocraft_physics -> symocraft_world")
        elseif(case STREQUAL "physics-link-indirect-world")
            string(APPEND cmakelists "target_link_libraries(symocraft_math INTERFACE symocraft_world)\n")
            set(expected "physics dependency closure symocraft_math")
        else()
            string(APPEND core_cmake "target_link_libraries(symocraft_physics PRIVATE $<BUILD_INTERFACE:symocraft_world>)\n")
            set(expected "physics dependency closure")
        endif()
    elseif(case STREQUAL "physics-link-native-library")
        string(APPEND core_cmake "target_link_libraries(symocraft_physics PRIVATE d3d12.lib)\n")
        set(expected "physics dependency closure")
    elseif(case STREQUAL "physics-source-wrong-owner")
        set(consumer simulation)
        set(consumer_target symocraft_simulation)
        set(expected "internal physics source has a unique target owner")
    elseif(case STREQUAL "physics-target-wrong-owner")
        file(WRITE "${root}/test/src/owned.cpp" "int wrong_owner() { return 0; }\n")
        file(WRITE "${root}/test/CMakeLists.txt"
            "add_library(symocraft_physics STATIC src/owned.cpp)\nset_target_properties(symocraft_physics PROPERTIES LINKER_LANGUAGE CXX)\n")
        string(APPEND cmakelists "add_subdirectory(test)\n")
        set(expected "physics target is declared outside simulation/physics")
    endif()
    if(NOT case MATCHES "^physics-(source-wrong-owner|target-wrong-owner)$")
        file(WRITE "${physics}/CMakeLists.txt" "${core_cmake}")
        string(APPEND cmakelists "add_subdirectory(game/modules/simulation/physics)\n")
    endif()
    if(consumer)
        if(consumer STREQUAL "app")
            set(directory "${root}/game/app")
        else()
            set(directory "${root}/game/modules/${consumer}")
        endif()
        file(WRITE "${directory}/src/owned.cpp" "int consumer_owned() { return 0; }\n")
        set(consumer_cmake "add_library(${consumer_target} STATIC src/owned.cpp)\nset_target_properties(${consumer_target} PROPERTIES LINKER_LANGUAGE CXX)\n")
        if(case STREQUAL "physics-source-wrong-owner")
            string(APPEND consumer_cmake "target_sources(${consumer_target} PRIVATE physics/src/owned.cpp)\n")
        elseif(case STREQUAL "physics-path-simulation-physics-include")
            string(APPEND consumer_cmake "target_include_directories(${consumer_target} PRIVATE \"${physics}/include\")\n")
        elseif(case STREQUAL "physics-target-app-alias-consumer")
            string(APPEND cmakelists "add_library(Physics::Core ALIAS symocraft_physics)\n")
            string(APPEND consumer_cmake "target_link_libraries(${consumer_target} PRIVATE Physics::Core)\n")
        elseif(case STREQUAL "physics-target-app-expression-consumer")
            string(APPEND consumer_cmake "target_link_libraries(${consumer_target} PRIVATE $<BUILD_INTERFACE:symocraft_physics>)\n")
        elseif(case STREQUAL "physics-target-app-expression-alias-consumer")
            string(APPEND cmakelists "add_library(Physics::Core ALIAS symocraft_physics)\n")
            string(APPEND consumer_cmake "target_link_libraries(${consumer_target} PRIVATE $<BUILD_INTERFACE:Physics::Core>)\n")
        else()
            string(APPEND consumer_cmake "target_link_libraries(${consumer_target} ${consumer_scope} symocraft_physics)\n")
        endif()
        file(WRITE "${directory}/CMakeLists.txt" "${consumer_cmake}")
        file(RELATIVE_PATH consumer_directory "${root}" "${directory}")
        string(APPEND cmakelists "add_subdirectory(${consumer_directory})\n")
    endif()
    unset(consumer)
    check_target("${case}" "${root}" "${cmakelists}" "${accepted}" "${expected}")
endforeach()

# Retired GLFW must not be configured, linked or made visible by active targets.
foreach(case IN ITEMS glfw-target-unlinked glfw-target-renamed glfw-link-platform
    glfw-link-platform-expression glfw-link-app glfw-link-library
    glfw-path-platform-private glfw-path-platform-public glfw-path-app glfw-path-library)
    set(root "${OUTPUT}/${case}")
    file(MAKE_DIRECTORY "${root}/vendor/glfw" "${root}/lib/glfw" "${root}/game/modules/platform/src" "${root}/game/app/src")
    set(cmakelists "cmake_minimum_required(VERSION 3.22)\nproject(GlfwRetirement LANGUAGES NONE)\nset(SYMOCRAFT_REPOSITORY_ROOT \"${root}\")\n")
    if(case MATCHES "^glfw-target-")
        if(case STREQUAL "glfw-target-unlinked")
            set(retired_target glfw)
        else()
            set(retired_target historical_window_library)
        endif()
        file(WRITE "${root}/vendor/glfw/CMakeLists.txt" "add_library(${retired_target} INTERFACE)\n")
        string(APPEND cmakelists "add_subdirectory(vendor/glfw EXCLUDE_FROM_ALL)\n")
        set(expected "retired GLFW target cannot be configured")
    else()
        if(case MATCHES "app$")
            set(directory "${root}/game/app")
            set(target symocraft_startup)
        else()
            set(directory "${root}/game/modules/platform")
            set(target symocraft_platform)
        endif()
        file(WRITE "${directory}/src/owned.cpp" "int owned() { return 0; }\n")
        set(owner_cmake "add_library(${target} STATIC src/owned.cpp)\nset_target_properties(${target} PROPERTIES LINKER_LANGUAGE CXX)\n")
        if(case MATCHES "^glfw-link-")
            if(case MATCHES "expression$")
                set(reference "$<BUILD_INTERFACE:glfw>")
            elseif(case MATCHES "library$")
                set(reference "${root}/lib/glfw/glfw3.lib")
            else()
                set(reference glfw)
            endif()
            string(APPEND owner_cmake "target_link_libraries(${target} PRIVATE \"${reference}\")\n")
            set(expected "retired GLFW link cannot enter production")
        else()
            if(case MATCHES "public$")
                set(scope PUBLIC)
            else()
                set(scope PRIVATE)
            endif()
            if(case MATCHES "library$")
                set(include_path "${root}/lib/glfw")
            else()
                set(include_path "${root}/vendor/glfw/include")
            endif()
            string(APPEND owner_cmake "target_include_directories(${target} ${scope} \"${include_path}\")\n")
            set(expected "gains retired GLFW")
        endif()
        file(WRITE "${directory}/CMakeLists.txt" "${owner_cmake}")
        file(RELATIVE_PATH owner_directory "${root}" "${directory}")
        string(APPEND cmakelists "add_subdirectory(${owner_directory})\n")
    endif()
    check_target("${case}" "${root}" "${cmakelists}" FALSE "${expected}")
endforeach()

# Only canonical private bridge headers are granted to the renderer.
foreach(case IN ITEMS bridge-renderer-native bridge-renderer-vulkan bridge-renderer-relative-native
    bridge-cpu-native bridge-cpu-vulkan bridge-app-native bridge-app-vulkan
    bridge-public-windows bridge-public-vulkan)
    set(root "${OUTPUT}/${case}")
    file(MAKE_DIRECTORY "${root}/game/modules/platform/src/graphics_bridge"
        "${root}/game/modules/renderer/src" "${root}/game/modules/world/src"
        "${root}/game/app/src" "${root}/game/modules/platform/include/symocraft/platform")
    file(WRITE "${root}/game/modules/platform/src/graphics_bridge/native_bridge.h" "#pragma once\n#include <Windows.h>\n")
    file(WRITE "${root}/game/modules/platform/src/graphics_bridge/vulkan_bridge.h" "#pragma once\n#include <vulkan/vulkan_core.h>\n")
    set(module renderer)
    set(path "${root}/game/modules/renderer/src/probe.cpp")
    set(accepted FALSE)
    if(case MATCHES "vulkan$")
        set(header vulkan_bridge.h)
    else()
        set(header native_bridge.h)
    endif()
    set(content "#include <${header}>\n")
    if(case MATCHES "^bridge-renderer-(native|vulkan)$")
        set(accepted TRUE)
    elseif(case STREQUAL "bridge-renderer-relative-native")
        set(content "#include \"../../platform/src/graphics_bridge/native_bridge.h\"\n")
    elseif(case MATCHES "^bridge-cpu-")
        set(module world)
        set(path "${root}/game/modules/world/src/probe.cpp")
    elseif(case MATCHES "^bridge-app-")
        set(module app)
        set(path "${root}/game/app/src/probe.cpp")
    else()
        set(module platform)
        set(path "${root}/game/modules/platform/include/symocraft/platform/probe.h")
        if(case STREQUAL "bridge-public-windows")
            set(content "#include <Windows.h>\n")
        else()
            set(content "#include <vulkan/vulkan_core.h>\n")
        endif()
    endif()
    check_source("${case}" "${root}" "${module}" "${path}" "${content}" "${accepted}")
endforeach()

# SDL target authorization is platform-private, including static LINK_ONLY edges.
foreach(case IN ITEMS sdl-target-platform-private sdl-target-platform-public sdl-target-renderer
    sdl-target-app sdl-target-cpu sdl-target-platform-public-expression sdl-target-renderer-expression
    sdl-path-platform-public sdl-path-renderer sdl-path-app sdl-path-cpu)
    set(root "${OUTPUT}/${case}")
    file(MAKE_DIRECTORY "${root}/vendor/sdl3/include/SDL3" "${root}/game/modules/platform/src"
        "${root}/game/modules/renderer/src" "${root}/game/modules/world/src" "${root}/game/app")
    file(WRITE "${root}/vendor/sdl3/include/SDL3/SDL.h" "#pragma once\n")
    file(WRITE "${root}/vendor/sdl3/CMakeLists.txt"
        "add_library(SDL3-static INTERFACE)\nadd_library(SDL3::SDL3-static ALIAS SDL3-static)\ntarget_include_directories(SDL3-static INTERFACE \"${root}/vendor/sdl3/include\")\n")
    if(case MATCHES "platform")
        set(owner platform)
        set(target symocraft_platform)
    elseif(case MATCHES "renderer")
        set(owner renderer)
        set(target symocraft_renderer)
    elseif(case MATCHES "app")
        set(owner app)
        set(target symocraft_startup)
    else()
        set(owner world)
        set(target symocraft_world)
    endif()
    if(owner STREQUAL "app")
        set(directory "${root}/game/app")
    else()
        set(directory "${root}/game/modules/${owner}")
    endif()
    file(MAKE_DIRECTORY "${directory}/src")
    file(WRITE "${directory}/src/owned.cpp" "int owned() { return 0; }\n")
    set(owner_cmake "add_library(${target} STATIC src/owned.cpp)\nset_target_properties(${target} PROPERTIES LINKER_LANGUAGE CXX)\n")
    set(scope PRIVATE)
    if(case MATCHES "public($|-)")
        set(scope PUBLIC)
    endif()
    if(case MATCHES "^sdl-path-")
        string(APPEND owner_cmake "target_include_directories(${target} ${scope} \"${root}/vendor/sdl3/include\")\n")
        set(expected "exposes private SDL include path")
    elseif(case MATCHES "expression$")
        string(APPEND owner_cmake "target_link_libraries(${target} ${scope} $<BUILD_INTERFACE:SDL3::SDL3-static>)\n")
        set(expected "SDL target references require a direct approved target")
    else()
        string(APPEND owner_cmake "target_link_libraries(${target} ${scope} SDL3::SDL3-static)\n")
        set(expected "SDL target is private to symocraft_platform")
    endif()
    file(WRITE "${directory}/CMakeLists.txt" "${owner_cmake}")
    file(RELATIVE_PATH owner_directory "${root}" "${directory}")
    # These target-property fixtures configure only and need no installed compiler.
    set(cmakelists
        "cmake_minimum_required(VERSION 3.22)\nproject(SdlBoundary LANGUAGES NONE)\nset(CMAKE_CXX_ARCHIVE_CREATE \"<CMAKE_COMMAND> -E true\")\nset(CMAKE_CXX_ARCHIVE_FINISH \"<CMAKE_COMMAND> -E true\")\nset(SYMOCRAFT_REPOSITORY_ROOT \"${root}\")\nadd_subdirectory(vendor/sdl3)\nadd_subdirectory(${owner_directory})\n")
    set(accepted FALSE)
    if(case STREQUAL "sdl-target-platform-private")
        set(accepted TRUE)
    endif()
    check_target("${case}" "${root}" "${cmakelists}" "${accepted}" "${expected}")
endforeach()

# Use actual CMake targets and the same configure-time validator as the product.
foreach(case IN ITEMS target-world-renderer target-simulation-platform target-module-app target-production-test broad-include duplicate-source target-cycle test-include target-game-benchmark public-private-path)
    set(root "${OUTPUT}/${case}")
    file(MAKE_DIRECTORY "${root}/game/modules/world/src" "${root}/game/modules/renderer/src"
        "${root}/game/modules/simulation/src" "${root}/game/modules/platform/src" "${root}/game/app" "${root}/test")
    set(cmakelists "cmake_minimum_required(VERSION 3.22)\nproject(NegativeBoundary LANGUAGES NONE)\nset(SYMOCRAFT_REPOSITORY_ROOT \"${root}\")\n")
    set(module world)
    if(case STREQUAL "target-simulation-platform")
        set(module simulation)
        set(dependency platform)
    elseif(case STREQUAL "target-world-renderer")
        set(dependency renderer)
    else()
        set(dependency "")
    endif()
    set(source "${root}/game/modules/${module}/src/owned.cpp")
    file(WRITE "${source}" "int owned() { return 0; }\n")
    set(module_cmake "add_library(symocraft_${module} STATIC src/owned.cpp)\nset_target_properties(symocraft_${module} PROPERTIES LINKER_LANGUAGE CXX)\n")
    if(dependency)
        file(WRITE "${root}/game/modules/${dependency}/src/owned.cpp" "int other() { return 0; }\n")
        file(WRITE "${root}/game/modules/${dependency}/CMakeLists.txt"
            "add_library(symocraft_${dependency} STATIC src/owned.cpp)\nset_target_properties(symocraft_${dependency} PROPERTIES LINKER_LANGUAGE CXX)\n")
        string(APPEND cmakelists "add_subdirectory(game/modules/${dependency})\n")
        string(APPEND module_cmake "target_link_libraries(symocraft_${module} PRIVATE symocraft_${dependency})\n")
        set(expected "Boundary violation: target")
    elseif(case STREQUAL "target-module-app")
        file(WRITE "${root}/game/app/CMakeLists.txt" "add_library(symocraft_startup INTERFACE)\n")
        string(APPEND cmakelists "add_subdirectory(game/app)\n")
        string(APPEND module_cmake "target_link_libraries(symocraft_world PRIVATE symocraft_startup)\n")
        set(expected "Boundary violation: module")
    elseif(case STREQUAL "target-production-test")
        file(WRITE "${root}/test/CMakeLists.txt" "add_library(test_fixture INTERFACE)\n")
        string(APPEND cmakelists "add_subdirectory(test)\n")
        string(APPEND module_cmake "target_link_libraries(symocraft_world PRIVATE test_fixture)\n")
        set(expected "Boundary violation: production")
    elseif(case STREQUAL "broad-include")
        string(APPEND module_cmake "target_include_directories(symocraft_world PUBLIC \"${root}/vendor\")\n")
        set(expected "Boundary violation: symocraft_world exposes broad")
    elseif(case STREQUAL "duplicate-source")
        string(APPEND module_cmake "add_library(duplicate STATIC src/owned.cpp)\nset_target_properties(duplicate PROPERTIES LINKER_LANGUAGE CXX)\n")
        set(expected "Boundary violation: duplicate production source")
    elseif(case STREQUAL "public-private-path")
        string(APPEND module_cmake "target_include_directories(symocraft_world PUBLIC \"${root}/game/modules/world/src\")\n")
        set(expected "Boundary violation: symocraft_world publishes private implementation")
    elseif(case STREQUAL "test-include")
        string(APPEND module_cmake "target_include_directories(symocraft_world PRIVATE \"${root}/test/support\")\n")
        set(expected "Boundary violation: production symocraft_world gains test include")
    elseif(case STREQUAL "target-game-benchmark")
        file(MAKE_DIRECTORY "${root}/tools/benchmark")
        file(WRITE "${root}/tools/benchmark/CMakeLists.txt" "add_library(benchmark_core INTERFACE)\n")
        file(WRITE "${root}/game/app/CMakeLists.txt" "add_library(symocraft_startup INTERFACE)\ntarget_link_libraries(symocraft_startup INTERFACE benchmark_core)\n")
        string(APPEND cmakelists "add_subdirectory(tools/benchmark)\nadd_subdirectory(game/app)\n")
        set(expected "Boundary violation: game symocraft_startup -> independent benchmark")
    else()
        string(APPEND module_cmake "target_link_libraries(symocraft_world PRIVATE symocraft_world)\n")
        set(expected "Boundary violation: cyclic production")
    endif()
    file(WRITE "${root}/game/modules/${module}/CMakeLists.txt" "${module_cmake}")
    string(APPEND cmakelists "add_subdirectory(game/modules/${module})\n")
    check_target("${case}" "${root}" "${cmakelists}" FALSE "${expected}")
endforeach()

