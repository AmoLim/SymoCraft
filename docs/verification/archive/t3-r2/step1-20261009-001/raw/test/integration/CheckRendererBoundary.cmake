cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED REPO OR NOT DEFINED BUILD_DIR)
    message(FATAL_ERROR "Pass absolute REPO and BUILD_DIR paths.")
endif()

foreach(required IN ITEMS renderer-targets.tsv compile_commands.json CMakeCache.txt build.ninja CMakeFiles/TargetDirectories.txt)
    if(NOT EXISTS "${BUILD_DIR}/${required}")
        message(FATAL_ERROR "Renderer boundary verification requires actual build artifact: ${required}")
    endif()
endforeach()

file(STRINGS "${BUILD_DIR}/renderer-targets.tsv" target_rows)
foreach(row IN LISTS target_rows)
    if(row MATCHES "^([^\t]+)\t([^\t]+)\t([^\t]+)\t(.*)$")
        set(target "${CMAKE_MATCH_1}")
        set(type "${CMAKE_MATCH_2}")
        set(property "${CMAKE_MATCH_3}")
        set(value "${CMAKE_MATCH_4}")
        set("record_${target}_${property}" "${value}")
        set("record_${target}_type" "${type}")
        list(APPEND actual_targets "${target}")
    endif()
endforeach()
list(REMOVE_DUPLICATES actual_targets)

foreach(target IN ITEMS symocraft_renderer_api symocraft_renderer renderer_public_api_consumer renderer_facade_tests)
    if(NOT target IN_LIST actual_targets)
        message(FATAL_ERROR "Actual target manifest is missing ${target}.")
    endif()
endforeach()
if(NOT record_symocraft_renderer_api_type STREQUAL "INTERFACE_LIBRARY" OR
   NOT record_symocraft_renderer_type STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "Public renderer API must be INTERFACE and implemented facade must be STATIC.")
endif()

set(forbidden_public "graphics_bridge|/renderer/src|\\\\renderer\\\\src|sdl|glad|vulkan|d3d12|dxgi|test/support|test/experimental")
foreach(target IN ITEMS symocraft_renderer_api symocraft_renderer)
    foreach(property IN ITEMS INTERFACE_INCLUDE_DIRECTORIES INTERFACE_LINK_LIBRARIES INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS)
        string(TOLOWER "${record_${target}_${property}}" public_value)
        if(target STREQUAL "symocraft_renderer" AND property STREQUAL "INTERFACE_LINK_LIBRARIES")
            # Static libraries propagate private link inputs without exposing their headers.
            string(REGEX REPLACE "\\$<link_only:[^>]*>" "" public_value "${public_value}")
        endif()
        if(public_value MATCHES "${forbidden_public}")
            message(FATAL_ERROR "${target} leaks SDK, private implementation, or tests through ${property}: ${record_${target}_${property}}")
        endif()
    endforeach()
endforeach()
if(NOT record_symocraft_renderer_api_INTERFACE_INCLUDE_DIRECTORIES MATCHES "renderer[/\\\\]include")
    message(FATAL_ERROR "Public API target does not export its real public include directory.")
endif()
if(NOT record_symocraft_renderer_api_INTERFACE_LINK_LIBRARIES MATCHES "symocraft_scene")
    message(FATAL_ERROR "Public API target must expose the CPU scene mesh contract dependency.")
endif()
if(NOT record_symocraft_renderer_INTERFACE_LINK_LIBRARIES MATCHES "symocraft_renderer_api")
    message(FATAL_ERROR "Implemented facade must expose its real public API target.")
endif()

foreach(property IN ITEMS SOURCES INCLUDE_DIRECTORIES LINK_LIBRARIES COMPILE_DEFINITIONS)
    if("${record_symocraft_renderer_${property}}" MATCHES "test[/\\\\](support|experimental)|d3d12[-_]r1|fixture|recording_backend|mock")
        message(FATAL_ERROR "Production renderer ${property} depends on experimental/test implementation.")
    endif()
endforeach()
foreach(target IN ITEMS renderer_public_api_consumer renderer_facade_tests)
    if(NOT record_${target}_LINK_LIBRARIES MATCHES "symocraft_renderer")
        message(FATAL_ERROR "${target} does not link the real production facade.")
    endif()
endforeach()

file(READ "${BUILD_DIR}/compile_commands.json" compile_commands)
string(JSON command_count LENGTH "${compile_commands}")
set(found_public FALSE)
set(found_facade FALSE)
set(found_implementation FALSE)
math(EXPR last_command "${command_count} - 1")
foreach(index RANGE 0 ${last_command})
    string(JSON source GET "${compile_commands}" ${index} file)
    string(JSON command GET "${compile_commands}" ${index} command)
    string(REPLACE "\\" "/" source "${source}")
    if(source MATCHES "/test/unit/renderer/public_api_consumer\\.cpp$")
        set(found_public TRUE)
        string(REPLACE "\\" "/" normalized_command "${command}")
        string(TOLOWER "${normalized_command}" normalized_command)
        if(normalized_command MATCHES "graphics_bridge|renderer/src|test/support|test/experimental|sdl|glad|vulkan|d3d12|dxgi")
            message(FATAL_ERROR "Actual public consumer compile command leaks private/SDK/test paths or defines: ${command}")
        endif()
    elseif(source MATCHES "/test/unit/renderer/facade_tests\\.cpp$")
        set(found_facade TRUE)
    elseif(source MATCHES "/game/modules/renderer/src/renderer_impl\\.cpp$")
        set(found_implementation TRUE)
    endif()
endforeach()
if(NOT found_public OR NOT found_facade OR NOT found_implementation)
    message(FATAL_ERROR "Compile commands do not prove public consumer, private lifecycle tests, and actual production implementation.")
endif()

file(READ "${BUILD_DIR}/build.ninja" build_graph)
file(READ "${BUILD_DIR}/CMakeFiles/TargetDirectories.txt" target_directories)
foreach(target IN ITEMS renderer_public_api_consumer renderer_facade_tests)
    string(REGEX MATCH "build [^\n]*${target}[^\n]*: CXX_EXECUTABLE_LINKER[^\n]*" link_edge "${build_graph}")
    if(NOT link_edge MATCHES "symocraft_renderer")
        message(FATAL_ERROR "Actual Ninja executable link edge for ${target} does not contain production renderer library.")
    endif()
    string(TOLOWER "${link_edge}" normalized_link_edge)
    if(normalized_link_edge MATCHES "sdl|glad|vulkan|d3d12|dxgi|symocraft_renderer_legacy_opengl|fixture")
        message(FATAL_ERROR "Actual CPU test link edge leaks native graphics or fixture libraries: ${link_edge}")
    endif()
endforeach()

file(STRINGS "${BUILD_DIR}/CMakeCache.txt" cpu_mode REGEX "^SYMOCRAFT_CPU_ONLY:BOOL=ON$")
if(cpu_mode)
    file(STRINGS "${BUILD_DIR}/CMakeCache.txt" sdk_cache REGEX "^(SDL[^:]*|Vulkan[^:]*|GLFW[^:]*|glfw[^:]*|D3D[^:]*|DXGI[^:]*|DXC[^:]*):")
    if(sdk_cache)
        message(FATAL_ERROR "CPU-only renderer build configured native SDK cache entries: ${sdk_cache}")
    endif()
    if("${build_graph}\n${target_directories}" MATCHES "symocraft_renderer_(legacy_opengl|d3d12|vulkan)|symocraft_glad|SDL[^ /\n]*\\.dir|vendor/(sdl3|glfw)")
        message(FATAL_ERROR "CPU-only renderer build configured or linked native graphics targets.")
    endif()
endif()

message(STATUS "Actual renderer target, public compile, production link, and CPU SDK boundaries passed; no GPU acceptance.")
