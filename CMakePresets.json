{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "BUILD_TESTING": true
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Symocraft MSVC"
        }
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 MSVC Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SYMOCRAFT_RENDER_D3D12": true,
        "SYMOCRAFT_ENABLE_TRACY": false,
        "SYMOCRAFT_GPU_DEBUG_MARKERS": false
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 MSVC Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYMOCRAFT_RENDER_D3D12": true,
        "SYMOCRAFT_ENABLE_TRACY": false,
        "SYMOCRAFT_GPU_DEBUG_MARKERS": false
      }
    },
    {
      "name": "windows-profiling",
      "displayName": "Windows x64 MSVC Release with profiling symbols",
      "inherits": "windows-release",
      "cacheVariables": {
        "SYMOCRAFT_ENABLE_TRACY": true,
        "SYMOCRAFT_GPU_DEBUG_MARKERS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-profiling",
      "configurePreset": "windows-profiling"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-profiling",
      "configurePreset": "windows-profiling",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
