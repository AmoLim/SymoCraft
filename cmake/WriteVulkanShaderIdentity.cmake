foreach(required IN ITEMS COMPILER SOURCE_ROOT OUTPUT_ROOT CONFIGURATION FLAGS)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing shader identity input: ${required}")
    endif()
endforeach()
function(json_string output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()
if(BACKEND STREQUAL "D3D12")
    set(identity "{\"schema\":1,\"backend\":\"D3D12\",\"format\":\"DXIL\",\"target\":\"d3d12\",\"shader_model\":\"6_0\"}")
    set(extension dxil)
else()
    set(identity "{\"schema\":1,\"backend\":\"Vulkan\",\"format\":\"SPIR-V\",\"target\":\"vulkan1.2\",\"shader_model\":\"6_0\"}")
    set(extension spv)
endif()
file(SHA256 "${COMPILER}" compiler_hash)
get_filename_component(compiler_directory "${COMPILER}" DIRECTORY)
file(SHA256 "${compiler_directory}/dxcompiler.dll" module_hash)
set(compiler_sha256 "${compiler_hash}")
set(compiler_module_sha256 "${module_hash}")
set(build_configuration "${CONFIGURATION}")
set(flags "${FLAGS}")
foreach(key IN ITEMS compiler_sha256 compiler_module_sha256 build_configuration flags)
    json_string(value "${${key}}")
    string(JSON identity SET "${identity}" "${key}" "${value}")
endforeach()
string(JSON identity SET "${identity}" source_sha256 "{}")
foreach(name IN ITEMS blocks.hlsl selection.hlsl draw_constants.hlsli)
    file(SHA256 "${SOURCE_ROOT}/${name}" hash)
    string(JSON identity SET "${identity}" source_sha256 "${name}" "\"${hash}\"")
endforeach()
string(JSON identity SET "${identity}" binary_sha256 "{}")
foreach(name IN ITEMS blocks.vs.${extension} blocks.ps.${extension} selection.vs.${extension} selection.ps.${extension})
    file(SHA256 "${OUTPUT_ROOT}/${name}" hash)
    string(JSON identity SET "${identity}" binary_sha256 "${name}" "\"${hash}\"")
endforeach()
file(WRITE "${OUTPUT_ROOT}/build.json" "${identity}\n")
