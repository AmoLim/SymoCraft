include_guard(GLOBAL)

set(entt_root "${SYMOCRAFT_REPOSITORY_ROOT}/vendor/entt")
if(NOT EXISTS "${entt_root}/src/entt/config/version.h" OR NOT EXISTS "${entt_root}/LICENSE")
    message(FATAL_ERROR "Fixed local EnTT v4.0.0 source and original license are required")
endif()
file(SHA256 "${entt_root}/LICENSE" entt_license_hash)
if(NOT entt_license_hash STREQUAL "73547f6370ee16ea560665329bb62d4e2d8250f41eaa204b47a6c694ca3286ea")
    message(FATAL_ERROR "EnTT original MIT license identity changed")
endif()
add_library(symocraft_entt INTERFACE)
set_property(TARGET symocraft_entt PROPERTY SYMOCRAFT_SOURCE_COMMIT "85c6bba014049b5de8fad49d25424df2f1f6a8c1")
target_include_directories(symocraft_entt SYSTEM INTERFACE "${entt_root}/src")
target_compile_features(symocraft_entt INTERFACE cxx_std_20)
target_compile_definitions(symocraft_entt INTERFACE ENTT_NO_ETO "$<$<CONFIG:Debug>:_ITERATOR_DEBUG_LEVEL=0>")
